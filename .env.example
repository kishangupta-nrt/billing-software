# Optional environment overrides. Copy to .env and load it explicitly, e.g.
#   node --env-file=.env server.js
# The launcher and `npm start` do not read .env automatically.

# Extra hostnames allowed by the Host-header allowlist (comma-separated, no port).
# localhost, loopback and private LAN IPs are always allowed.
ALLOWED_HOSTS=

# Extra browser origins allowed by CORS (comma-separated, including scheme).
ALLOWED_ORIGINS=

# Data locations. Defaults are the app's data/, Saved Invoices/ and Trash/.
GST_DATA_DIR=
GST_INVOICES_DIR=
GST_TRASH_DIR=
